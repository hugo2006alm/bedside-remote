{
  "manifest_version": 3,
  "name": "Bedside Remote",
  "version": "0.1.0",
  "description": "Control YouTube and Netflix through your paired Bedside Remote Windows agent.",
  "browser_specific_settings": {
    "gecko": {
      "id": "bedside-remote@hugo2006alm",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["browsingActivity", "websiteContent", "websiteActivity"]
      }
    }
  },
  "permissions": ["nativeMessaging", "alarms"],
  "host_permissions": [
    "https://youtube.com/*",
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://music.youtube.com/*",
    "https://www.netflix.com/*",
    "https://netflix.com/*"
  ],
  "background": {"scripts": ["background.js"]},
  "content_scripts": [{
    "matches": [
      "https://youtube.com/*",
      "https://www.youtube.com/*",
      "https://m.youtube.com/*",
      "https://music.youtube.com/*",
      "https://www.netflix.com/*",
      "https://netflix.com/*"
    ],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "action": {"default_title": "Bedside Remote", "default_popup": "popup.html"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
